{
  "name": "ghostacoustics",
  "version": "0.0.0",
  "private": true,
  "description": "Airtime-budgeted acoustic datagram transport framework and dev kit.",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node tools/serve.mjs",
    "serve": "node tools/serve.mjs",
    "compile": "pnpm --filter @ghost-acoustics/schema-compiler compile",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:pbt": "pnpm -r --if-present test:pbt",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
